<div class="p-4">
  <h1 class="text-4xl font-bold text-center mb-1">Recipster</h1>
  <p class="text-center text-gray-600 mb-6 italic">What recipes can you cook with ingredients you have at home?</p>

  <!-- Recipe Search Form -->
  <div class="max-w-2xl mx-auto mb-8">
    <form id="recipe-search-form" class="relative">
      <div class="relative">
        <input
          type="text"
          id="recipe-name-search"
          placeholder="Search for recipes by name..."
          class="w-full px-4 py-3 pl-12 pr-4 text-lg border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent shadow-sm"
        >
        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
          <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
        <button
          type="submit"
          class="absolute inset-y-0 right-0 px-4 py-2 bg-blue-600 text-white rounded-r-lg hover:bg-blue-700 transition-colors"
        >
          Search
        </button>
      </div>
    </form>
  </div>

  <div class="flex gap-6" data-controller="ingredient-search" data-ingredient-search-url-value="/ingredients/search">
    <!-- Sidebar with Filters -->
    <div class="w-80 bg-white rounded-lg shadow-lg p-6 h-fit">
      <h2 class="text-xl font-semibold mb-6">Filters</h2>

      <!-- Ingredients Filter -->
      <div class="mb-6">
        <h3 class="text-lg font-semibold mb-3">Ingredients</h3>
        <div class="relative mb-4">
          <input
            type="search"
            placeholder="Add an ingredient..."
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
          >
        </div>

        <!-- Common Ingredients -->
        <div class="mb-4">
          <h4 class="text-sm font-medium mb-2 text-gray-700">Common Ingredients:</h4>
          <div class="flex flex-wrap gap-2">
            <button class="common-ingredient-btn inline-flex items-center gap-1 px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-sm hover:bg-blue-200 transition-colors" data-ingredient-name="egg">
              <span>egg</span>
              <span class="text-blue-600">+</span>
            </button>
            <button class="common-ingredient-btn inline-flex items-center gap-1 px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-sm hover:bg-blue-200 transition-colors" data-ingredient-name="garlic">
              <span>garlic</span>
              <span class="text-blue-600">+</span>
            </button>
            <button class="common-ingredient-btn inline-flex items-center gap-1 px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-sm hover:bg-blue-200 transition-colors" data-ingredient-name="onion">
              <span>onion</span>
              <span class="text-blue-600">+</span>
            </button>
            <button class="common-ingredient-btn inline-flex items-center gap-1 px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-sm hover:bg-blue-200 transition-colors" data-ingredient-name="white sugar">
              <span>white sugar</span>
              <span class="text-blue-600">+</span>
            </button>
            <button class="common-ingredient-btn inline-flex items-center gap-1 px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-sm hover:bg-blue-200 transition-colors" data-ingredient-name="all-purpose flour">
              <span>all-purpose flour</span>
              <span class="text-blue-600">+</span>
            </button>
            <button class="common-ingredient-btn inline-flex items-center gap-1 px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-sm hover:bg-blue-200 transition-colors" data-ingredient-name="olive oil">
              <span>olive oil</span>
              <span class="text-blue-600">+</span>
            </button>
            <button class="common-ingredient-btn inline-flex items-center gap-1 px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-sm hover:bg-blue-200 transition-colors" data-ingredient-name="butter">
              <span>butter</span>
              <span class="text-blue-600">+</span>
            </button>
            <button class="common-ingredient-btn inline-flex items-center gap-1 px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-sm hover:bg-blue-200 transition-colors" data-ingredient-name="milk">
              <span>milk</span>
              <span class="text-blue-600">+</span>
            </button>
          </div>
        </div>

        <!-- Selected Ingredients -->
        <div class="mb-4">
          <h4 class="text-sm font-medium mb-2 text-gray-700">Selected Ingredients:</h4>
          <ul id="ingredients-list" class="flex flex-wrap gap-2 min-h-[50px] p-2 bg-gray-50 rounded-lg">
            <!-- Ingredients will be added here -->
          </ul>
        </div>

        <button
          id="clear-ingredients"
          class="w-full px-4 py-2 bg-gray-500 text-white rounded-lg hover:bg-gray-600 transition-colors text-sm"
        >
          Clear All Ingredients
        </button>
      </div>

      <!-- Cooking Time Filter -->
      <div class="mb-6">
        <h3 class="text-lg font-semibold mb-3">Cooking Time</h3>
        <div class="space-y-2">
          <label class="flex items-center">
            <input type="radio" name="cooking-time" value="15" class="mr-2">
            <span class="text-sm">Under 15 minutes</span>
          </label>
          <label class="flex items-center">
            <input type="radio" name="cooking-time" value="30" class="mr-2">
            <span class="text-sm">Under 30 minutes</span>
          </label>
          <label class="flex items-center">
            <input type="radio" name="cooking-time" value="60" class="mr-2">
            <span class="text-sm">Under 1 hour</span>
          </label>
          <label class="flex items-center">
            <input type="radio" name="cooking-time" value="" class="mr-2">
            <span class="text-sm">Any time</span>
          </label>
        </div>
      </div>

      <!-- Rating Filter -->
      <div class="mb-6">
        <h3 class="text-lg font-semibold mb-3">Minimum Rating</h3>
        <div class="space-y-2">
          <label class="flex items-center">
            <input type="radio" name="rating" value="4.5" class="mr-2">
            <span class="text-sm">4.5+ stars</span>
          </label>
          <label class="flex items-center">
            <input type="radio" name="rating" value="4.0" class="mr-2">
            <span class="text-sm">4.0+ stars</span>
          </label>
          <label class="flex items-center">
            <input type="radio" name="rating" value="3.5" class="mr-2">
            <span class="text-sm">3.5+ stars</span>
          </label>
          <label class="flex items-center">
            <input type="radio" name="rating" value="" class="mr-2">
            <span class="text-sm">Any rating</span>
          </label>
        </div>
      </div>

          <!-- Category Filter -->
          <div class="mb-6">
            <h3 class="text-lg font-semibold mb-3">Category</h3>
            <select class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
              <option value="">All Categories</option>
              <option value="Appetizers and Snacks">Appetizers and Snacks</option>
              <option value="Asian Recipes">Asian Recipes</option>
              <option value="Baked and Roasted Chicken">Baked and Roasted Chicken</option>
              <option value="Beef Main Dishes">Beef Main Dishes</option>
              <option value="Bread Recipes">Bread Recipes</option>
              <option value="Breakfast and Brunch">Breakfast and Brunch</option>
              <option value="Cake Recipes">Cake Recipes</option>
              <option value="Casseroles">Casseroles</option>
              <option value="Chicken Main Dishes">Chicken Main Dishes</option>
              <option value="Chicken Recipes">Chicken Recipes</option>
              <option value="Chili">Chili</option>
              <option value="Chinese Recipes">Chinese Recipes</option>
              <option value="Chocolate Desserts">Chocolate Desserts</option>
              <option value="Cookies">Cookies</option>
              <option value="Desserts">Desserts</option>
              <option value="Dips and Spreads">Dips and Spreads</option>
              <option value="Drinks">Drinks</option>
              <option value="French Recipes">French Recipes</option>
              <option value="German Recipes">German Recipes</option>
              <option value="Greek Recipes">Greek Recipes</option>
              <option value="Grilled Cheese Sandwiches">Grilled Cheese Sandwiches</option>
              <option value="Ground Beef">Ground Beef</option>
              <option value="Ice Cream">Ice Cream</option>
              <option value="Indian Recipes">Indian Recipes</option>
              <option value="Italian Recipes">Italian Recipes</option>
              <option value="Japanese Recipes">Japanese Recipes</option>
              <option value="Korean Recipes">Korean Recipes</option>
              <option value="Lamb Recipes">Lamb Recipes</option>
              <option value="Main Dishes">Main Dishes</option>
              <option value="Mexican Recipes">Mexican Recipes</option>
              <option value="Muffins">Muffins</option>
              <option value="Pancakes">Pancakes</option>
              <option value="Pasta Main Dishes">Pasta Main Dishes</option>
              <option value="Pasta Salad">Pasta Salad</option>
              <option value="Pizza">Pizza</option>
              <option value="Pork Recipes">Pork Recipes</option>
              <option value="Potato Side Dishes">Potato Side Dishes</option>
              <option value="Rice Side Dishes">Rice Side Dishes</option>
              <option value="Salad Recipes">Salad Recipes</option>
              <option value="Salmon Recipes">Salmon Recipes</option>
              <option value="Sandwiches">Sandwiches</option>
              <option value="Seafood Main Dishes">Seafood Main Dishes</option>
              <option value="Side Dishes">Side Dishes</option>
              <option value="Smoothies">Smoothies</option>
              <option value="Soup">Soup</option>
              <option value="Spanish Recipes">Spanish Recipes</option>
              <option value="Stew">Stew</option>
              <option value="Stir-Fries">Stir-Fries</option>
              <option value="Thai Recipes">Thai Recipes</option>
              <option value="Turkey Recipes">Turkey Recipes</option>
              <option value="Vegetarian Main Dishes">Vegetarian Main Dishes</option>
              <option value="Vegetarian Recipes">Vegetarian Recipes</option>
              <option value="Waffles">Waffles</option>
            </select>
          </div>

      <!-- Apply Filters Button -->
      <button
        id="apply-filters"
        class="w-full px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
      >
        Apply Filters
      </button>
    </div>

    <!-- Main Content Area -->
    <div class="flex-1">
      <!-- Messages -->
      <div id="messages" class="mb-4">
        <!-- Messages will appear here -->
      </div>

      <!-- Recipe Results -->
      <div id="recipes-section" style="display: none;">
        <!-- Recipe results will appear here -->
      </div>
    </div>
  </div>
</div>
